# Comma-separated browser origins allowed to call the API during development.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection settings. Keep the real password in backend/.env only.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=paperpilot_dev
DB_USER=paperpilot_app
DB_PASSWORD=YOUR_LOCAL_PASSWORD

# Authentication only. Generate 32 random bytes with secrets.token_hex(32).
# Set the resulting 64 hexadecimal characters in your local backend/.env.
JWT_SECRET_KEY=

